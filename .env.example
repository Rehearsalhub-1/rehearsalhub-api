# Supabase Postgres connection string
DATABASE_URL=""
# Optional direct/admin connection used only by `npm run migrate:auth-internal`.
DATABASE_ADMIN_URL=""
AUTH_RUNTIME_ROLE="rehearsalhub_app"

# Secret key — the other developer must pass this in the x-api-key header
API_SECRET_KEY="your-strong-secret-key-here"

# Port (Railway sets this automatically)
PORT=3000
CORS_ALLOWED_ORIGINS="https://your-admin.example.com,https://your-portal.example.com"

# Secret used by the portal/Vercel cron caller for internal scheduled jobs
CRON_SECRET="your-cron-secret-here"

# JWT auth — generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-256-bit-secret-here"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# LiveKit — voice & video calls (used by /livekit-token endpoint)
# Self-hosted: set LIVEKIT_URL to your own server (e.g. wss://livekit.yourdomain.com)
#   API key + secret are defined in your livekit-config.yaml when self-hosting
# LiveKit Cloud: copy key/secret from https://cloud.livekit.io
LIVEKIT_URL="wss://your-livekit-server.example.com"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Cloudflare R2 (media/file uploads)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="rehearsalhub-media"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
