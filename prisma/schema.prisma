// Prisma schema file for RehearsalHub Canonical Schema
// Consolidated Database Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 1. REPERTOIRE & SONGS
// ============================================================================

model Song {
  id              String    @id
  title           String?
  key             String?
  tempo           String?
  lyrics          String?
  writer          String?
  category        String?
  audioFile       String?   @map("audio_file")
  audioUrls       Json?     @map("audio_urls")
  conductor       String?
  leadSinger      String?   @map("lead_singer")
  drummer         String?
  leadKeyboardist String?   @map("lead_keyboardist")
  leadGuitarist   String?   @map("lead_guitarist")
  bassGuitarist   String?   @map("bass_guitarist")
  solfas          String?
  scope           String?   @default("hq")
  zoneId          String?   @map("zone_id")
  subgroupId      String?   @map("subgroup_id")
  praiseNightId   String?   @map("praise_night_id")
  status          String?
  isActive        Boolean?  @map("is_active")
  isMinistered    Boolean?  @default(false) @map("is_ministered")
  rehearsalCount  Int?      @default(0) @map("rehearsal_count")
  categories      Json?
  createdAt       String?   @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  rawData         Json?     @map("raw_data")

  @@map("songs")
}

// ============================================================================
// 2. PROGRAMS, REHEARSALS & EVENTS
// ============================================================================

model Program {
  id             String    @id
  name           String?
  date           String?
  scope          String?   @default("hq")
  zoneId         String?   @map("zone_id")
  subgroupId     String?   @map("subgroup_id")
  category       String?
  status         String?   @default("pre-rehearsal")
  isActive       Boolean?  @default(false) @map("is_active")
  isArchived     Boolean?  @default(false) @map("is_archived")
  location       String?
  bannerImage    String?   @map("banner_image")
  songs          Json?
  songIds        Json?     @map("song_ids")
  rehearsalCount Int?      @default(0) @map("rehearsal_count")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  rawData        Json?     @map("raw_data")

  @@map("programs")
}

// ============================================================================
// 3. USERS, PROFILES & AUTH
// ============================================================================

model Profile {
  id               String    @id
  email            String?
  name             String?
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  role             String?   @default("member")
  zoneId           String?   @map("zone_id")
  subgroupId       String?   @map("subgroup_id")
  churchId         String?   @map("church_id")
  voicePart        String?   @map("voice_part")
  permissions      Json?     @default("{}")
  status           String?   @default("active")
  phone            String?
  hasHqAccess      Boolean?  @map("has_hq_access")
  avatarUrl        String?   @map("avatar_url")
  createdAt        DateTime? @map("created_at")
  rawData          Json?     @map("raw_data")
  kingschatId      String?   @map("kingschat_id")
  profileCompleted Boolean?  @map("profile_completed")
  updatedAt        String?   @map("updated_at")

  authCredential   AuthCredential?
  refreshTokens    RefreshToken[]

  @@map("profiles")
}

model AuthCredential {
  profileId    String   @id @map("profile_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")
  profile      Profile  @relation(fields: [profileId], references: [id])

  @@map("auth_credentials")
}

model RefreshToken {
  id        String   @id
  profileId String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], name: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}

// ============================================================================
// 4. ZONES & SUBGROUPS
// ============================================================================

model Zone {
  id             String    @id
  name           String?
  code           String?
  country        String?
  region         String?
  invitationCode String?   @map("invitation_code")
  isHq           Boolean?  @default(false) @map("is_hq")
  isActive       Boolean?  @default(true) @map("is_active")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  rawData        Json?     @map("raw_data")

  subgroups      Subgroup[]

  @@map("zones")
}

model Subgroup {
  id               String    @id
  name             String
  zoneId           String    @map("zone_id")
  description      String?
  type             String?   @default("church")
  status           String?   @default("active")
  coordinatorId    String?   @map("coordinator_id")
  coordinatorName  String?   @map("coordinator_name")
  estimatedMembers Int?      @map("estimated_members")
  createdBy        String?   @map("created_by")
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  rawData          Json?     @map("raw_data")

  zone             Zone      @relation(fields: [zoneId], references: [id])

  @@map("subgroups")
}

// ============================================================================
// 5. CHATS, MESSAGES & CALLS
// ============================================================================

model Chat {
  id                 String    @id
  type               String?
  createdBy          String?   @map("created_by")
  participants       Json?
  participantDetails Json?     @map("participant_details")
  unreadCount        Json?     @map("unread_count")
  createdAt          DateTime? @default(now()) @map("created_at")
  rawData            Json?     @map("raw_data")

  messages           Message[]

  @@map("chats")
}

model Message {
  id         String   @id
  text       String?
  type       String?  @default("text")
  chatId     String   @map("chat_id")
  edited     Boolean?
  status     String?
  senderId   String   @map("sender_id")
  senderName String?  @map("sender_name")
  reactions  Json?
  rawData    Json?    @map("raw_data")

  chat       Chat     @relation(fields: [chatId], references: [id])

  @@map("messages")
}

model Call {
  id      String @id
  rawData Json?  @map("raw_data")

  @@map("calls")
}

model UserStatus {
  id      String @id
  rawData Json?  @map("raw_data")

  @@map("user_statuses")
}

// ============================================================================
// 6. PLAYLISTS & FAVORITES
// ============================================================================

model Playlist {
  id        String    @id
  userId    String?   @map("user_id")
  title     String?
  scope     String?   @default("user")
  type      String?   @default("user")
  isPublic  Boolean?  @default(false) @map("is_public")
  songIds   Json?     @map("song_ids")
  songs     Json?
  zoneId    String?   @map("zone_id")
  rawData   Json?     @map("raw_data")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("playlists")
}

// ============================================================================
// 7. MEDIA ASSETS & CATEGORIES
// ============================================================================

model MediaAsset {
  id          String    @id
  title       String?
  scope       String?   @default("hq")
  zoneId      String?   @map("zone_id")
  subgroupId  String?   @map("subgroup_id")
  type        String?   @default("audio")
  folder      String?
  size        Int?
  mimeType    String?   @map("mime_type")
  rawData     Json?     @map("raw_data")

  @@map("media_assets")
}

model Category {
  id        String    @id
  name      String?
  scope     String?   @default("hq")
  zoneId    String?   @map("zone_id")
  type      String?   @default("program")
  color     String?
  order     Int?
  rawData   Json?     @map("raw_data")

  @@map("categories")
}

// ============================================================================
// 8. NOTIFICATIONS
// ============================================================================

model Notification {
  id             String    @id
  userId         String?   @map("user_id")
  title          String?
  body           String?
  message        String?
  type           String?   @default("system")
  category       String?
  priority       String?   @default("normal")
  zoneId         String?   @map("zone_id")
  isRead         Boolean?  @default(false) @map("is_read")
  senderId       String?   @map("sender_id")
  actionUrl      String?   @map("action_url")
  targetUserId   String?   @map("target_user_id")
  targetAudience String?   @map("target_audience")
  createdAt      DateTime? @default(now()) @map("created_at")
  rawData        Json?     @map("raw_data")

  @@map("notifications")
}

// ============================================================================
// 9. AUDIOLAB & USER WORKSPACES
// ============================================================================

model AudioLabProject {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("audiolab_projects")
}

model AudioLabSession {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("audiolab_sessions")
}

model AudioLabProgress {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("audiolab_progress")
}

model Attendance {
  id                String    @id
  userId            String?   @map("user_id")
  rehearsalId       String?   @map("rehearsal_id")
  status            String?
  scannedAt         DateTime? @map("scanned_at")
  createdAt         DateTime? @map("created_at")
  zoneId            String?   @map("zone_id")
  userName          String?   @map("user_name")
  eventName         String?   @map("event_name")
  qrCode            String?   @map("qr_code")
  checkInTime       String?   @map("check_in_time")
  recordedByAdminId String?   @map("recorded_by_admin_id")
  rawData           Json?     @map("raw_data")

  @@map("attendance")
}

model ActivityLog {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("activity_logs")
}

model AnalyticsSession {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("analytics_events")
}

model AnalyticsMonthly {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("analytics_monthly")
}

model SimplifiedAnalytics {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("simplified_analytics")
}

model Presence {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("presence")
}

model UserSession {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("user_sessions")
}

model WatchHistory {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("watch_history")
}

model SongHistory {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("song_history")
}

model UserSongNote {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("user_song_notes")
}

model MediaDoodle {
  id        String    @id
  songId    String?   @map("song_id")
  userId    String?   @map("user_id")
  data      Json?
  createdAt DateTime? @map("created_at")
  rawData   Json?     @map("raw_data")

  @@map("media_doodles")
}

model MediaComment {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("media_comments")
}

model AchievementTemplate {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("achievement_templates")
}

model AppSetting {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("app_settings")
}

model Setting {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("settings")
}

model SystemMetadata {
  id        String    @id
  rawData   Json?     @map("raw_data")

  @@map("system_metadata")
}

model AdminRequest {
  id            String    @id
  userId        String?   @map("user_id")
  userEmail     String?   @map("user_email")
  userName      String?   @map("user_name")
  zoneId        String?   @map("zone_id")
  zoneCode      String?   @map("zone_code")
  requestedRole String?   @map("requested_role")
  status        String?
  reason        String?
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  rawData       Json?     @map("raw_data")

  @@map("admin_requests")
}

model SubmittedSong {
  id               String    @id
  userId           String?   @map("user_id")
  title            String?
  status           String?
  createdAt        DateTime? @map("created_at")
  zoneId           String?   @map("zone_id")
  submittedBy      String?   @map("submitted_by")
  submittedByEmail String?   @map("submitted_by_email")
  rawData          Json?     @map("raw_data")

  @@map("submitted_songs")
}

model SupportTicket {
  id             String    @id
  userId         String?   @map("user_id")
  userName       String?   @map("user_name")
  userEmail      String?   @map("user_email")
  subject        String?
  category       String?
  status         String?
  priority       String?
  zoneId         String?   @map("zone_id")
  lastMessage    String?   @map("last_message")
  lastTimestamp  DateTime? @map("last_timestamp")
  unreadByAdmin  Int?      @default(0) @map("unread_by_admin")
  unreadByUser   Int?      @default(0) @map("unread_by_user")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  rawData        Json?     @map("raw_data")

  @@map("support_tickets")
}
