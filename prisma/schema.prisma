// ============================================================================
// RehearsalHub — Canonical Multi-Tenant Schema v2
// Architecture: Organization (HQ / Regional) -> Subgroup -> User & Memberships
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum MemberRole {
  SUPER_ADMIN
  HQ_ADMIN
  ZONE_ADMIN
  SUBGROUP_ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SongStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProgramStatus {
  PRE_REHEARSAL
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CategoryType {
  PROGRAM
  SONG
  MEDIA
  PAGE
}

enum MediaType {
  AUDIO
  VIDEO
  IMAGE
  DOCUMENT
}

enum ChatType {
  DIRECT
  GROUP
  ANNOUNCEMENT
}

enum MessageType {
  TEXT
  AUDIO
  VIDEO
  IMAGE
  FILE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================================================
// 1. TENANCY & ORGANIZATIONS
// ============================================================================

model Organization {
  id             String   @id @default(cuid())
  name           String?
  code           String?  @unique
  country        String?
  region         String?
  isHq           Boolean  @default(false)  @map("is_hq")
  invitationCode String?  @unique          @map("invitation_code")
  isActive       Boolean  @default(true)   @map("is_active")
  createdAt      DateTime @default(now())  @map("created_at")
  updatedAt      DateTime @updatedAt       @map("updated_at")
  rawData        Json?    @map("raw_data")

  subgroups              Subgroup[]
  memberships            Membership[]
  songs                  Song[]
  programs               Program[]
  categories             Category[]
  mediaAssets            MediaAsset[]
  broadcastNotifications BroadcastNotification[]
  playlists              Playlist[]
  adminRequests          AdminRequest[]
  submittedSongs         SubmittedSong[]
  supportTickets         SupportTicket[]
  attendances            Attendance[]
  chats                  Chat[]

  @@map("zones")
}

model Subgroup {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  name             String
  description      String?
  type             String?      @default("church")
  status           String?      @default("active")
  estimatedMembers Int?         @map("estimated_members")
  createdAt        DateTime?    @default(now()) @map("created_at")
  updatedAt        DateTime?    @updatedAt      @map("updated_at")
  rawData          Json?        @map("raw_data")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  songs            Song[]
  programs         Program[]
  mediaAssets      MediaAsset[]

  @@index([organizationId])
  @@map("subgroups")
}

// ============================================================================
// 2. IDENTITY & MEMBERSHIP
// ============================================================================

model User {
  id               String    @id
  email            String?   @unique
  name             String?
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url")
  kingschatId      String?   @map("kingschat_id")
  profileCompleted Boolean?  @default(false) @map("profile_completed")
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt      @map("updated_at")
  rawData          Json?     @map("raw_data")

  credential       AuthCredential?
  refreshTokens    RefreshToken[]
  memberships      Membership[]

  playlists             Playlist[]
  songHistory           SongHistory[]
  mediaDoodles          MediaDoodle[]

  messagesAuthored       Message[]
  chatsCreated           Chat[]
  chatParticipations     ChatParticipant[]
  notificationDeliveries NotificationDelivery[]
  broadcastsSent         BroadcastNotification[]

  adminRequestsMade     AdminRequest[]       @relation("admin_request_user")
  adminRequestsReviewed AdminRequest[]       @relation("admin_request_reviewer")
  songsSubmitted        SubmittedSong[]      @relation("submitted_song_user")
  supportTickets        SupportTicket[]
  attendances           Attendance[]         @relation("attendance_user")
  attendancesRecorded   Attendance[]         @relation("attendance_recorder")
  songRoleAssignments   SongRoleAssignment[]

  @@map("profiles")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  subgroupId     String?      @map("subgroup_id")
  role           MemberRole   @default(MEMBER)
  voicePart      String?      @map("voice_part")
  status         MemberStatus @default(ACTIVE)
  hasHqAccess    Boolean      @default(false) @map("has_hq_access")
  permissions    Json?        @default("{}")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  updatedAt      DateTime     @updatedAt      @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subgroup       Subgroup?    @relation(fields: [subgroupId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([organizationId, subgroupId])
  @@index([userId])
  @@map("memberships")
}

model AuthCredential {
  userId       String    @id   @map("user_id")
  passwordHash String         @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt      @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// 3. REPERTOIRE
// ============================================================================

model Song {
  id              String        @id @default(cuid())
  organizationId  String?       @map("organization_id")
  subgroupId      String?       @map("subgroup_id")
  title           String?
  key             String?
  tempo           String?
  lyrics          String?
  writer          String?
  category        String?
  audioFile       String?       @map("audio_file")
  audioUrls       Json?         @map("audio_urls")
  conductor       String?
  leadSinger      String?       @map("lead_singer")
  drummer         String?
  leadKeyboardist String?       @map("lead_keyboardist")
  leadGuitarist   String?       @map("lead_guitarist")
  bassGuitarist   String?       @map("bass_guitarist")
  solfas          String?
  programId       String?       @map("praise_night_id")
  status          String?       @default("active")
  isMinistered    Boolean       @default(false) @map("is_ministered")
  rehearsalCount  Int           @default(0)     @map("rehearsal_count")
  isActive        Boolean       @default(true)  @map("is_active")
  categories      Json?
  createdAt       DateTime?     @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt      @map("updated_at")
  rawData         Json?         @map("raw_data")

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subgroup        Subgroup?     @relation(fields: [subgroupId], references: [id], onDelete: SetNull)
  program         Program?      @relation("song_program", fields: [programId], references: [id], onDelete: SetNull)

  roleAssignments SongRoleAssignment[]
  songCategories  SongCategory[]
  playlistItems   PlaylistItem[]
  programSongs    ProgramSong[]
  mediaDoodles    MediaDoodle[]
  songHistory     SongHistory[]

  @@index([organizationId])
  @@index([organizationId, subgroupId])
  @@map("songs")
}

model SongRoleAssignment {
  id     String @id @default(cuid())
  songId String @map("song_id")
  userId String @map("user_id")
  role   String

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId, role])
  @@index([songId])
  @@map("song_role_assignments")
}

// ============================================================================
// 4. PROGRAMS
// ============================================================================

model Program {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  subgroupId     String?       @map("subgroup_id")
  name           String?
  date           String?
  category       String?
  status         String?       @default("pre-rehearsal")
  isActive       Boolean?      @default(false) @map("is_active")
  isArchived     Boolean?      @default(false) @map("is_archived")
  location       String?
  bannerImage    String?       @map("banner_image")
  songs          Json?
  songIds        Json?         @map("song_ids")
  rehearsalCount Int?          @default(0) @map("rehearsal_count")
  createdAt      DateTime?     @default(now()) @map("created_at")
  updatedAt      DateTime?     @updatedAt      @map("updated_at")
  rawData        Json?         @map("raw_data")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subgroup       Subgroup?     @relation(fields: [subgroupId], references: [id], onDelete: SetNull)
  programSongs   ProgramSong[]
  attendances    Attendance[]
  relatedSongs   Song[]        @relation("song_program")

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("programs")
}

model ProgramSong {
  id        String  @id @default(cuid())
  programId String  @map("program_id")
  songId    String  @map("song_id")
  order     Int?

  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  song      Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([programId, songId])
  @@index([programId])
  @@map("program_songs")
}

// ============================================================================
// 5. PLAYLISTS
// ============================================================================

model Playlist {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  organizationId String?       @map("organization_id")
  title          String?
  isPublic       Boolean?      @default(false) @map("is_public")
  songs          Json?
  songIds        Json?         @map("song_ids")
  createdAt      DateTime?     @default(now()) @map("created_at")
  updatedAt      DateTime?     @updatedAt      @map("updated_at")
  rawData        Json?         @map("raw_data")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PlaylistItem[]

  @@index([userId])
  @@index([organizationId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String   @map("playlist_id")
  songId     String   @map("song_id")
  order      Int?

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@map("playlist_items")
}

// ============================================================================
// 6. TAXONOMY
// ============================================================================

model Category {
  id             String        @id @default(cuid())
  organizationId String?       @map("zone_id")
  name           String?
  type           CategoryType  @default(PROGRAM)
  color          String?
  order          Int?
  rawData        Json?         @map("raw_data")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  songs          SongCategory[]

  @@unique([organizationId, name, type])
  @@index([organizationId])
  @@map("categories")
}

model SongCategory {
  songId     String   @map("song_id")
  categoryId String   @map("category_id")

  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([songId, categoryId])
  @@map("song_categories")
}

// ============================================================================
// 7. MEDIA
// ============================================================================

model MediaAsset {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  subgroupId     String?       @map("subgroup_id")
  title          String?
  type           String?       @default("AUDIO")
  folder         String?
  size           Int?
  mimeType       String?       @map("mime_type")
  rawData        Json?         @map("raw_data")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subgroup       Subgroup?     @relation(fields: [subgroupId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("media_assets")
}

model MediaComment {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("media_comments")
}

// ============================================================================
// 8. MESSAGING
// ============================================================================

model Chat {
  id             String          @id @default(cuid())
  organizationId String?         @map("organization_id")
  type           ChatType        @default(DIRECT)
  createdById    String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  rawData        Json?           @map("raw_data")

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants   ChatParticipant[]
  messages       Message[]

  @@map("chats")
}

model ChatParticipant {
  chatId      String   @map("chat_id")
  userId      String   @map("user_id")
  unreadCount Int      @default(0) @map("unread_count")
  joinedAt    DateTime @default(now()) @map("joined_at")

  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id        String      @id @default(cuid())
  chatId    String      @map("chat_id")
  senderId  String      @map("sender_id")
  text      String?
  type      MessageType @default(TEXT)
  edited    Boolean?    @default(false)
  status    String?
  reactions Json?
  rawData   Json?       @map("raw_data")

  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

model Call {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("calls")
}

// ============================================================================
// 9. NOTIFICATIONS
// ============================================================================

model BroadcastNotification {
  id             String               @id @default(cuid())
  organizationId String?              @map("organization_id")
  senderId       String?              @map("sender_id")
  title          String
  body           String
  message        String?
  type           String               @default("announcement")
  category       String?
  priority       NotificationPriority @default(NORMAL)
  actionUrl      String?              @map("action_url")
  createdAt      DateTime             @default(now()) @map("created_at")
  rawData        Json?                @map("raw_data")

  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User?                @relation(fields: [senderId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@index([organizationId, createdAt])
  @@map("broadcast_notifications")
}

model NotificationDelivery {
  id             String                @id @default(cuid())
  notificationId String                @map("notification_id")
  userId         String                @map("user_id")
  isRead         Boolean               @default(false) @map("is_read")
  readAt         DateTime?             @map("read_at")

  notification   BroadcastNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@map("notification_deliveries")
}

// ============================================================================
// 10. ATTENDANCE
// ============================================================================

model Attendance {
  id             String        @id @default(cuid())
  programId      String?       @map("rehearsal_id")
  organizationId String?       @map("zone_id")
  userId         String?       @map("user_id")
  status         String?
  scannedAt      DateTime?     @map("scanned_at")
  checkInTime    DateTime?     @map("check_in_time")
  qrCode         String?       @map("qr_code")
  recordedById   String?       @map("recorded_by_admin_id")
  eventName      String?       @map("event_name")
  createdAt      DateTime?     @default(now()) @map("created_at")
  rawData        Json?         @map("raw_data")

  program        Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation("attendance_user", fields: [userId], references: [id], onDelete: SetNull)
  recordedBy     User?         @relation("attendance_recorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([programId, userId])
  @@index([organizationId, programId])
  @@map("attendance")
}

// ============================================================================
// 11. ADMIN WORKFLOWS
// ============================================================================

model AdminRequest {
  id             String        @id @default(cuid())
  userId         String?       @map("user_id")
  organizationId String?       @map("zone_id")
  requestedRole  String?       @map("requested_role")
  status         RequestStatus @default(PENDING)
  reason         String?
  reviewedById   String?       @map("reviewed_by")
  reviewedAt     DateTime?     @map("reviewed_at")
  createdAt      DateTime?     @default(now()) @map("created_at")
  updatedAt      DateTime?     @updatedAt      @map("updated_at")
  rawData        Json?         @map("raw_data")

  user           User?         @relation("admin_request_user", fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy     User?         @relation("admin_request_reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("admin_requests")
}

model SubmittedSong {
  id               String           @id @default(cuid())
  userId           String?          @map("user_id")
  zoneId           String?          @map("zone_id")
  title            String?
  status           SubmissionStatus @default(PENDING)
  submittedBy      String?          @map("submitted_by")
  submittedByEmail String?          @map("submitted_by_email")
  createdAt        DateTime?        @default(now()) @map("created_at")
  rawData          Json?            @map("raw_data")

  user             User?            @relation("submitted_song_user", fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, status])
  @@map("submitted_songs")
}

model SupportTicket {
  id             String         @id @default(cuid())
  userId         String?        @map("user_id")
  organizationId String?        @map("zone_id")
  subject        String?
  category       String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  lastMessage    String?        @map("last_message")
  lastTimestamp  DateTime?      @map("last_timestamp")
  unreadByAdmin  Int?           @default(0) @map("unread_by_admin")
  unreadByUser   Int?           @default(0) @map("unread_by_user")
  createdAt      DateTime?      @default(now()) @map("created_at")
  updatedAt      DateTime?      @updatedAt      @map("updated_at")
  rawData        Json?          @map("raw_data")

  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("support_tickets")
}

// ============================================================================
// 12. PERSONAL WORKSPACE
// ============================================================================

model WatchHistory {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("watch_history")
}

model SongHistory {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  songId      String?   @map("song_id")
  rehearsalId String?   @map("rehearsal_id")
  type        String?
  title       String?
  newValue    String?   @map("new_value")
  oldValue    String?   @map("old_value")
  createdBy   String?   @map("created_by")
  description String?
  createdAt   DateTime? @default(now()) @map("created_at")
  rawData     Json?     @map("raw_data")

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song        Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("song_history")
}

model UserSongNote {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("user_song_notes")
}

model MediaDoodle {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  songId    String?   @map("song_id")
  data      Json?
  createdAt DateTime? @default(now()) @map("created_at")
  rawData   Json?     @map("raw_data")

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("media_doodles")
}

// ============================================================================
// 13. AUDIOLAB
// ============================================================================

model AudioLabProject {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("audiolab_projects")
}

model AudioLabSession {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("audiolab_sessions")
}

// ============================================================================
// 14. ANALYTICS & EVENTS
// ============================================================================

model AnalyticsEvent {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("analytics_events")
}

model Setting {
  id        String    @id @default(cuid())
  key       String
  value     Json
  updatedAt DateTime? @updatedAt @map("updated_at")
  rawData   Json?     @map("raw_data")

  @@map("settings")
}

model Presence {
  id      String @id
  rawData Json?  @map("raw_data")

  @@map("presence")
}

model AchievementTemplate {
  id      String @id @default(cuid())
  rawData Json?  @map("raw_data")

  @@map("achievement_templates")
}

model UserStatus {
  id      String @id
  rawData Json?  @map("raw_data")

  @@map("user_statuses")
}

model ActivityLog {
  id      String @id
  rawData Json?  @map("raw_data")

  @@map("activity_logs")
}
