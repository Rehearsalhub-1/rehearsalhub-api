// ============================================================================
// RehearsalHub — Canonical Pure Relational Schema (3NF)
// Architecture: Organization (Workspace) -> Group (Unit/Church) -> Memberships
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 1. WORKSPACE & TENANCY (Organizations & Groups)
// ============================================================================

model Organization {
  id             String    @id @default(cuid())
  name           String
  code           String?   @unique
  country        String?
  region         String?
  isHq           Boolean   @default(false) @map("is_hq")
  invitationCode String?   @unique @map("invitation_code")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  groups         Group[]
  memberships    Membership[]
  songs          Song[]
  programs       Program[]
  categories     Category[]
  mediaAssets    MediaAsset[]
  playlists      Playlist[]
  chats          Chat[]
  notifications  Notification[]
  attendances    Attendance[]
  submittedSongs SubmittedSong[]
  supportTickets SupportTicket[]

  @@map("organizations")
}

model Group {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  name             String
  description      String?
  type             String?      @default("church") // church, band, orchestra, choir
  status           String?      @default("active")
  estimatedMembers Int?         @default(0) @map("estimated_members")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  songs            Song[]
  programs         Program[]
  mediaAssets      MediaAsset[]

  @@index([organizationId])
  @@map("groups")
}

// ============================================================================
// 2. IDENTITY & ACCESS CONTROL
// ============================================================================

model User {
  id               String    @id
  email            String?   @unique
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url")
  kingschatId      String?   @map("kingschat_id")
  profileCompleted Boolean   @default(false) @map("profile_completed")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  credential       AuthCredential?
  refreshTokens    RefreshToken[]
  memberships      Membership[]

  playlists             Playlist[]
  songHistory           SongHistory[]
  messagesAuthored       Message[]
  chatsCreated           Chat[]
  chatParticipations     ChatParticipant[]
  notificationsSent      Notification[]         @relation("notification_sender")
  notificationDeliveries NotificationDelivery[]
  submittedSongs         SubmittedSong[]        @relation("submitted_song_user")
  supportTickets        SupportTicket[]
  attendances           Attendance[]           @relation("attendance_user")
  attendancesRecorded   Attendance[]           @relation("attendance_recorder")
  songRoleAssignments   SongRoleAssignment[]
  callsMade             Call[]                 @relation("calls_made")
  callsReceived         Call[]                 @relation("calls_received")
  mediaDoodles          MediaDoodle[]
  userSongNotes         UserSongNote[]
  statuses              UserStatus[]

  @@map("profiles")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  groupId        String?      @map("group_id")
  role           String       @default("MEMBER") // 'ORG_ADMIN' | 'GROUP_ADMIN' | 'MEMBER'
  voicePart      String?      @map("voice_part") // 'SOPRANO' | 'ALTO' | 'TENOR' | 'BASS'
  status         String       @default("ACTIVE") // 'ACTIVE' | 'INACTIVE' | 'SUSPENDED'
  joinedAt       DateTime     @default(now()) @map("joined_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([organizationId, groupId])
  @@index([userId])
  @@map("memberships")
}

model AuthCredential {
  userId       String   @id @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// 3. SONG REPERTOIRE (Master Songs & Custom Program Songs)
// ============================================================================

model Song {
  id              String        @id @default(cuid())
  organizationId  String?       @map("organization_id") // Null if Global Master Library Song
  groupId         String?       @map("group_id")
  title           String
  key             String?
  tempo           String?
  lyrics          String?       @db.Text
  writer          String?
  category        String?
  audioFile       String?       @map("audio_file") // Master full mix URL
  audioUrls       Json?         @map("audio_urls") // Stem parts: { "full": "...", "BAND": "...", ... }
  conductor       String?
  leadSinger      String?       @map("lead_singer")
  drummer         String?
  leadKeyboardist String?       @map("lead_keyboardist")
  leadGuitarist   String?       @map("lead_guitarist")
  bassGuitarist   String?       @map("bass_guitarist")
  solfas          String?       @db.Text
  isMaster        Boolean       @default(false) @map("is_master") // Public catalog accessible to all orgs
  isMinistered    Boolean       @default(false) @map("is_ministered")
  status          String        @default("active") // active, heard, unheard
  rehearsalCount  Int           @default(0) @map("rehearsal_count")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group           Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)

  roleAssignments SongRoleAssignment[]
  songCategories  SongCategory[]
  playlistItems   PlaylistItem[]
  programSongs    ProgramSong[]
  songHistory     SongHistory[]
  mediaDoodles    MediaDoodle[]
  userSongNotes   UserSongNote[]

  @@index([organizationId])
  @@index([isMaster])
  @@index([isMinistered])
  @@map("songs")
}

model SongRoleAssignment {
  id     String @id @default(cuid())
  songId String @map("song_id")
  userId String @map("user_id")
  role   String // LEAD_SINGER, CONDUCTOR, DRUMMER, etc.

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId, role])
  @@index([songId])
  @@map("song_role_assignments")
}

// ============================================================================
// 4. PROGRAMS & REHEARSALS (Praise Nights & Services)
// ============================================================================

model Program {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  groupId        String?       @map("group_id")
  name           String
  date           String?
  category       String?       @default("praise_night")
  status         String        @default("pre-rehearsal") // pre-rehearsal, active, completed, archived
  location       String?
  bannerImage    String?       @map("banner_image")
  isActive       Boolean       @default(false) @map("is_active")
  isArchived     Boolean       @default(false) @map("is_archived")
  rehearsalCount Int           @default(0) @map("rehearsal_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  programSongs   ProgramSong[]
  attendances    Attendance[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("programs")
}

model ProgramSong {
  id        String  @id @default(cuid())
  programId String  @map("program_id")
  songId    String  @map("song_id")
  order     Int     @default(1)

  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  song      Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([programId, songId])
  @@index([programId])
  @@map("program_songs")
}

// ============================================================================
// 5. PLAYLISTS
// ============================================================================

model Playlist {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  organizationId String?        @map("organization_id")
  title          String
  isPublic       Boolean        @default(false) @map("is_public")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PlaylistItem[]

  @@index([userId])
  @@index([organizationId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String   @map("playlist_id")
  songId     String   @map("song_id")
  order      Int      @default(1)

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@map("playlist_items")
}

// ============================================================================
// 6. CATEGORIES & TAXONOMY
// ============================================================================

model Category {
  id             String         @id @default(cuid())
  organizationId String?        @map("organization_id")
  name           String
  type           String         @default("PROGRAM") // PROGRAM, SONG, MEDIA
  color          String?
  order          Int?           @default(0)

  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  songs          SongCategory[]

  @@unique([organizationId, name, type])
  @@index([organizationId])
  @@map("categories")
}

model SongCategory {
  songId     String   @map("song_id")
  categoryId String   @map("category_id")

  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([songId, categoryId])
  @@map("song_categories")
}

// ============================================================================
// 7. MEDIA ASSETS
// ============================================================================

model MediaAsset {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  groupId        String?       @map("group_id")
  title          String
  url            String        @db.Text
  thumbnail      String?       @db.Text
  type           String        @default("AUDIO") // AUDIO, VIDEO, IMAGE, DOCUMENT
  folder         String?
  size           BigInt?
  mimeType       String?       @map("mime_type")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("media_assets")
}

// ============================================================================
// 8. MESSAGING & CHAT CHANNELS
// ============================================================================

model Chat {
  id             String            @id @default(cuid())
  organizationId String?           @map("organization_id")
  type           String            @default("direct") // direct, group
  title          String?
  createdById    String            @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants   ChatParticipant[]
  messages       Message[]

  @@map("chats")
}

model ChatParticipant {
  chatId      String   @map("chat_id")
  userId      String   @map("user_id")
  unreadCount Int      @default(0) @map("unread_count")
  joinedAt    DateTime @default(now()) @map("joined_at")

  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  senderId  String   @map("sender_id")
  text      String?  @db.Text
  type      String   @default("text") // text, song_share, media, system
  edited    Boolean  @default(false)
  status    String   @default("sent") // sent, delivered, read
  createdAt DateTime @default(now()) @map("created_at")

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

// ============================================================================
// 9. NOTIFICATIONS & DELIVERIES
// ============================================================================

model Notification {
  id             String                 @id @default(cuid())
  organizationId String?                @map("organization_id") // Null if Global Broadcast
  senderId       String?                @map("sender_id")
  title          String
  body           String                 @db.Text
  type           String                 @default("announcement") // announcement, reminder, system
  category       String?
  priority       String                 @default("normal") // low, normal, high, urgent
  actionUrl      String?                @map("action_url")
  createdAt      DateTime               @default(now()) @map("created_at")

  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User?                  @relation("notification_sender", fields: [senderId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@index([organizationId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String       @map("notification_id")
  userId         String       @map("user_id")
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@map("notification_deliveries")
}

// ============================================================================
// 10. ATTENDANCE TRACKING
// ============================================================================

model Attendance {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  programId      String?       @map("program_id")
  status         String        @default("present")
  eventName      String?       @map("event_name")
  checkInTime    DateTime?     @map("check_in_time")
  scannedAt      DateTime?     @map("scanned_at")
  qrCode         String?       @map("qr_code")
  recordedById   String?       @map("recorded_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation("attendance_user", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy     User?         @relation("attendance_recorder", fields: [recordedById], references: [id], onDelete: SetNull)
  program        Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([programId, userId])
  @@index([organizationId, programId])
  @@map("attendance")
}

// ============================================================================
// 11. WORKFLOWS & WORKSPACE ENTITIES
// ============================================================================

model SubmittedSong {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  title          String
  lyrics         String?       @db.Text
  audioUrl       String?       @map("audio_url")
  notes          String?       @db.Text
  status         String        @default("pending") // pending, under_review, approved, rejected
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation("submitted_song_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("submitted_songs")
}

model SupportTicket {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  userId         String        @map("user_id")
  subject        String
  category       String?
  status         String        @default("open") // open, in_progress, resolved, closed
  priority       String        @default("normal") // low, normal, high, urgent
  lastMessage    String?       @map("last_message")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("support_tickets")
}

model SongHistory {
  id          String   @id @default(cuid())
  songId      String   @map("song_id")
  userId      String?  @map("user_id")
  type        String?  // lyrics_edit, key_change, tempo_change
  description String?
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at")

  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([songId, createdAt])
  @@map("song_history")
}

// ============================================================================
// 12. CALLS & DOODLES
// ============================================================================

model Call {
  id           String   @id @default(cuid())
  callerId     String   @map("caller_id")
  receiverId   String   @map("receiver_id")
  type         String   @default("voice") // voice, video
  chatId       String?  @map("chat_id")
  roomId       String?  @map("room_id")
  callerName   String?  @map("caller_name")
  callerAvatar String?  @map("caller_avatar")
  status       String   @default("ringing") // ringing, active, ended, missed, rejected
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  caller       User     @relation("calls_made", fields: [callerId], references: [id], onDelete: Cascade)
  receiver     User     @relation("calls_received", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@map("calls")
}

model MediaDoodle {
  id        String   @id @default(cuid())
  songId    String   @map("song_id")
  userId    String   @map("user_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId])
  @@map("media_doodles")
}

model UserSongNote {
  id        String   @id @default(cuid())
  songId    String   @map("song_id")
  userId    String   @map("user_id")
  notes     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId])
  @@map("user_song_notes")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model UserStatus {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaUrl  String   @map("media_url")
  type      String   @default("image") // image, video
  caption   String?
  viewers   String[] @default([])
  likes     String[] @default([])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_statuses")
}


